{
  "name": "@admiralcoder/api-test-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Senior QA REST API automation framework with Playwright and Zod",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:contract": "playwright test --grep @contract",
    "test:negative": "playwright test --grep @negative",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "zod": "^4.1.0"
  }
}
